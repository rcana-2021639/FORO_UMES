{
  "name": "foro-posgrado-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend (Strapi 5 + PostgreSQL) del sitio web del Foro Interuniversitario de Estudios de Posgrado",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prepare": "husky",
    "seed": "tsx scripts/seed.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration tests/api",
    "test:coverage": "jest --coverage",
    "db:test:create": "docker compose exec -T postgres psql -U postgres -c \"CREATE DATABASE foro_posgrado_test OWNER foro_app\""
  },
  "dependencies": {
    "@strapi/database": "5.53.0",
    "@strapi/plugin-documentation": "^5.53.0",
    "@strapi/plugin-sentry": "^5.53.0",
    "@strapi/plugin-users-permissions": "5.53.0",
    "@strapi/provider-email-nodemailer": "^5.53.0",
    "@strapi/provider-upload-aws-s3": "^5.53.0",
    "@strapi/strapi": "5.53.0",
    "koa-compress": "^5.2.2",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "sanitize-html": "~2.16.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/koa-compress": "^4.0.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.0.0"
  },
  "strapi": {
    "uuid": "5c782484-95c6-408d-a8f5-70758130ac01",
    "installId": "d13c9411e2bbc4e5baebc902790c91e02e1e8355de17d138182bc7e04ea92f93"
  },
  "overrides": {
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4",
    "vite": "^6.4.3"
  }
}
