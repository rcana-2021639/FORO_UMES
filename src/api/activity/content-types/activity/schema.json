{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Actividad",
    "description": "Encuentro, conferencia, seminario, reunion o proyecto del Foro"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 250
    },
    "type": {
      "type": "enumeration",
      "enum": ["Encuentro", "Conferencia", "Seminario", "Reunion", "Proyecto"],
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "participatingUniversities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::university.university",
      "inversedBy": "activities"
    },
    "contributions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contribution.contribution",
      "mappedBy": "relatedActivity"
    },
    "galleryItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-item.gallery-item",
      "mappedBy": "relatedActivity"
    }
  }
}
