{
  "kind": "collectionType",
  "collectionName": "contributions",
  "info": {
    "singularName": "contribution",
    "pluralName": "contributions",
    "displayName": "Aporte",
    "description": "Resultado, iniciativa o beneficio del trabajo conjunto. Usa borrador/publicado nativo: solo lo publicado es visible al publico"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 250
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["Resultado", "Iniciativa", "Beneficio"],
      "required": true
    },
    "publishedOn": {
      "type": "date",
      "required": true
    },
    "relatedActivity": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::activity.activity",
      "inversedBy": "contributions"
    }
  }
}
