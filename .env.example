# Copia este archivo a `.env` y llena los valores. NUNCA subas `.env` al repositorio.
# Genera cada secreto con:  openssl rand -base64 32   (o: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")

# ---------- Servidor ----------
HOST=0.0.0.0
PORT=1337

# ---------- Secretos de Strapi (uno distinto por entorno) ----------
# APP_KEYS acepta varias claves separadas por coma
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# ---------- Base de datos (PostgreSQL) ----------
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=foro_posgrado_dev
# Usuario LIMITADO con el que se conecta Strapi (no el superusuario)
DATABASE_USERNAME=foro_app
DATABASE_PASSWORD=
DATABASE_SSL=false

# ---------- Solo para docker-compose (administrador del contenedor) ----------
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
