# Copia este archivo a `.env` y llena los valores. NUNCA subas `.env` al repositorio.
# Genera cada secreto con:  openssl rand -base64 32   (o: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")

# ---------- Servidor ----------
HOST=0.0.0.0
PORT=1337

# ---------- Secretos de Strapi (uno distinto por entorno) ----------
# APP_KEYS acepta varias claves separadas por coma
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# ---------- Base de datos (PostgreSQL) ----------
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=foro_posgrado_dev
# Usuario LIMITADO con el que se conecta Strapi (no el superusuario)
DATABASE_USERNAME=foro_app
DATABASE_PASSWORD=
DATABASE_SSL=false

# ---------- Solo para docker-compose (administrador del contenedor) ----------
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# ---------- URL pública del backend (correos, OpenAPI). Vacío en desarrollo ----------
PUBLIC_URL=
# true cuando corre detrás del proxy del hosting (Railway/Render)
TRUST_PROXY=false

# ---------- Formulario de contacto ----------
# Correo del responsable de comunicación del Foro que recibe los mensajes
CONTACT_NOTIFY_EMAIL=

# ---------- Correo saliente (SMTP). Vacío = no se envía, solo se registra en el log ----------
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Remitente (dominio verificado en Resend)
MAIL_FROM=
MAIL_REPLY_TO=

# ---------- Archivos en producción: Cloudflare R2 (compatible con S3). Vacío = disco local ----------
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
