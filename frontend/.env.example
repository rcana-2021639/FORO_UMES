# URL pública del backend Strapi (sin barra final). El navegador y el servidor de Next la usan.
# En local usa 127.0.0.1 y no "localhost": Node resuelve localhost a ::1 y Strapi escucha en IPv4.
NEXT_PUBLIC_API_URL=http://127.0.0.1:1337

# Solo en producción: URL pública de los archivos subidos (el S3_PUBLIC_URL del backend, Cloudflare R2).
# Sin ella las imágenes se sirven desde NEXT_PUBLIC_API_URL/uploads (disco local de Strapi).
NEXT_PUBLIC_MEDIA_URL=

# URL pública de este sitio (sin barra final): enlaces canónicos, sitemap, robots y Open Graph.
# En producción, el dominio definitivo del Foro. Sin ella se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Credencial del servidor de Next ante el backend: el MISMO valor que FRONTEND_API_TOKEN del .env
# de Strapi. Le da un límite de tasa propio. Solo del servidor: NO lleva NEXT_PUBLIC_.
FRONTEND_API_TOKEN=
